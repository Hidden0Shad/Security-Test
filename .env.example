# Copy this file to .env and fill in a real value.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-your-own-generated-value-here
SESSION_TIMEOUT_MINUTES=30

#set to 'console' to print OTP directly in terminal
# set to 'mailtrap' to send realistic mock emails (requires the credentials below.)

OTP_DELIVERY_MODE=input_method_here 

MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user_name_here
MAILTRAP_PASS=your_mailtrap_pass_word_here

